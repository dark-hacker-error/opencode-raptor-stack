{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "rea-agents@6.5.0",
        "mcp"
      ],
      "environment": {
        "REA_JADX_MCP_JAR": "/opt/rea/jadx-headless-mcp-0.7.1-all.jar",
        "JAVA_HOME": "/opt/jdk-21.0.12.1+1",
        "GHIDRA_INSTALL_DIR": "/opt/ghidra_12.1.4_PUBLIC",
        "REA_TSHARK_COMMAND": "tshark"
      },
      "enabled": true
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      }
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_PAT>"
      },
      "enabled": true
    }
  }
}