  {
   "id": "hikerapi_phone",
   "name": "HikerAPI \u2014 phone to full profile",
   "category": "phone",
   "method": "GET",
   "url": "https://api.hikerapi.com/v2/user/by/id?id={phone}",
   "params": [
    "phone"
   ],
   "auth": "header",
   "headers": {
    "accept": "application/json",
    "x-access-key": "{key}"
   },
   "fields": [
    "name",
    "gender",
    "age",
    "country",
    "state",
    "city",
    "pincode",
    "address",
    "email",
    "carrier",
    "line_type",
    "sim"
   ],
   "notes": "Returns name, gender, location, carrier, email for an Indian mobile number."
  },
